{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#abd290",
      "2": "#a0cfcf",
      "3": "#bdcbaf"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#e1e4d9"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#abd290"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#abd290"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#a0cfcf"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#bdcbaf"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#466731"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
